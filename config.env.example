# Angel One SmartAPI Credentials
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Subscribe tokens: format "exchangeType:token,exchangeType:token"
# Exchange types: 1=NSE_CM, 2=NSE_FO, 3=BSE_CM, 4=BSE_FO, 5=MCX_FO
# Example: SBIN(3045) + Reliance(2885) on NSE
# Traded index as EXCH:TOKEN (bare token = NSE): default for SUBSCRIBE_TOKENS, STRAT_/ANALYST_SUBSCRIBE_TOKENS,
# EXITWATCH_INDEX_KEYS and CLOSE_REF_TOKEN. Set those only to override.
INDEX_TOKEN=NSE:99926000
SUBSCRIBE_TOKENS=1:3045,1:2885

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# SQLite
SQLITE_PATH=data/candles.db

# Metrics server
METRICS_ADDR=:9091

# API Gateway
GATEWAY_ADDR=:9090

# NIFTY50_SR entry quality checks (the STRAT_RANGE_ prefix is historical)
# Calendar days of 1m NIFTY history (from SQLITE_PATH) replayed at startup
# so 15m ADX / levels are ready at the open
STRAT_RANGE_WARMUP_DAYS=5
# Entry quality guard: check the bought option against Angel OptionGreek
# (liquidity, IV, cost below); no greeks / no Angel session → entry refused.
STRAT_RANGE_DELTA_GUARD=true
# Checks that run with the delta guard (need the option chain); 0 = off.
# Contract liquidity = max(volume, open interest) from OptionGreek.
STRAT_RANGE_MIN_LIQUIDITY=5000
# Refuse buying an option whose IV% is above this (premium too expensive).
STRAT_RANGE_MAX_BUY_IV=25
# Expected option gain at target (|delta| × index move) must be ≥ this × round-trip slippage.
STRAT_RANGE_COST_MULTIPLE=3

# Paper fills cross the spread: BUY at LTP+slip, SELL at LTP−slip,
# slip = max(LTP × bps / 10000, min paise). 0/0 = fill at LTP. Real orders untouched.
STRAT_PAPER_SLIPPAGE_BPS=50
STRAT_PAPER_SLIPPAGE_MIN_PAISE=50

# Global end-of-day backstop: exit everything and block entries (IST).
# NIFTY50_SR already exits at 15:10, before NSE's closing auction session.
STRAT_EOD_EXIT_TIME=15:15

# ── Archiver (EOD SQLite → MEGA, then local prune + VACUUM) ──
ARCHIVE_ENABLED=true
MEGA_EMAIL=hej65002@gmail.com
MEGA_PASSWORD=Rohan@9675
MEGA_ROOT_DIR=algo-archive
ARCHIVE_RUN_AT=16:00
ARCHIVE_KEEP_1S_DAYS=10
ARCHIVE_KEEP_TF_DAYS=10
ARCHIVE_KEEP_FEATURES_DAYS=10
